rame_run_id":19,"frame_seq":18,"frame_ts_ms":1792296177214,"id":"i|noun|2","lemma":"i","norm":"i","pos":"noun","score":0.5,"semantic_atoms":["ety:1","tag:countable","tag:uncountable","qual:metaphysics","pos_raw:noun"],"source":"ltm","synonyms":["me#Noun"],"token_index":0,"word":"i"},{"antonyms":[],"definition":"(letter, uppercase) The ninth letter of the English alphabet, called i and written in the Latin script.","example":null,"frame_run_id":19,"frame_seq":18,"frame_ts_ms":1792296177214,"id":"i|phrase|5","lemma":"i","norm":"i","pos":"phrase","score":0.5,"semantic_atoms":["ety:2","tag:letter","tag:uppercase","pos_raw:character"],"source":"ltm","synonyms":[],"token_index":0,"word":"i"},{"antonyms":[],"definition":"(alt-of, ordinal, uppercase, number) The ordinal number ninth, derived from this letter of the English alphabet, called i and written in the Latin script.","example":null,"frame_run_id":19,"frame_seq":18,"frame_ts_ms":1792296177214,"id":"i|numeral|2","lemma":"i","norm":"i","pos":"numeral","score":0.5,"semantic_atoms":["ety:2","tag:alt-of","tag:ordinal","tag:uppercase","rtag:number","pos_raw:num"],"source":"ltm","synonyms":[],"token_index":0,"word":"i"},{"antonyms":[],"definition":"(roadway, us, countable, uncountable) Interstate.","example":"I-95 begins at Houlton, Maine and terminates at Miami, Florida, connecting numerous major cities in the East Coast.","frame_run_id":19,"frame_seq":18,"frame_ts_ms":1792296177214,"id":"i|noun|3","lemma":"i","norm":"i","pos":"noun","score":0.5,"semantic_atoms":["ety:3","usage:region:american english","tag:us","tag:countable","tag:uncountable","qual:roadway","pos_raw:noun"],"source":"ltm","synonyms":[],"token_index":0,"word":"i"},{"antonyms":[],"definition":"(abbreviation, alt-of, countable, uncountable) Abbreviation of instrumental case.","example":null,"frame_run_id":19,"frame_seq":18,"frame_ts_ms":1792296177214,"id":"i|noun|4","lemma":"i","norm":"i","pos":"noun","score":0.5,"semantic_atoms":["ety:3","cat:en:grammar","t