x":5,"word":"bank"},{"antonyms":[],"definition":"A major London Underground station in the City of London, named after the Bank of England and one of the busiest stations on the network (OS grid ref TQ3281)","example":"Anybody familiar with the London Underground network will know that Bank Tube station is a place to be avoided - if at all possible - on a weekday morning. Located at the very heart of London's 'Square Mile' financial district, some 70,000 people detrain there during the morning peak, to pass through its gatelines and those at the adjoining station at Monument. A further 50,000 passengers squeeze into the station complex at exactly the same time of day, in order to change between the five lines that pass through it.","frame_run_id":16,"frame_seq":15,"frame_ts_ms":1792297317191,"id":"bank|proper_noun|2","lemma":"bank","norm":"bank","pos":"proper_noun","score":0.5,"semantic_atoms":["ety:1","pos_raw:name"],"source":"ltm","synonyms":[],"token_index":5,"word":"bank"},{"antonyms":[],"definition":"A surname.","example":null,"frame_run_id":16,"frame_seq":15,"frame_ts_ms":1792297317191,"id":"bank|proper_noun|3","lemma":"bank","norm":"bank","pos":"proper_noun","score":0.5,"semantic_atoms":["ety:2","cat:en:english surnames","pos_raw:name"],"source":"ltm","synonyms":[],"token_index":5,"word":"bank"},{"antonyms":[],"definition":"(form-of, participle, past) simple past and past participle of deposit","example":null,"frame_run_id":16,"frame_seq":15,"frame_ts_ms":1792297317191,"id":"deposited|verb|1","lemma":"deposited","norm":"deposited","pos":"verb","score":0.5,"semantic_atoms":["tag:form-of","tag:participle","tag:past","pos_raw:verb"],"source":"ltm","synonyms":[],"token_index":1,"word":"deposited"},{"antonyms":[],"definition":"(letter, lowercase) The ninth letter of the English alphabet, called i and written in the Latin script.","example":null,"frame_run_id":16,"frame_seq":15,"frame_ts_ms":1792297317191,"id":"i|phrase|1","lemma":"i","norm":"i","pos":"phrase","sco