rame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|6","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","tag:obsolete","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing origin. — Indicating an ancestral source or origin of descent.","example":"The word is believed to be of Japanese origin.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|7","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing origin. — Introducing an epithet that indicates a birthplace, residence, dominion, or other place associated with the individual.","example":"Jesus of Nazareth (after hometown)","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|8","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing origin. — Indicating a (non-physical) source of action or emotion; introducing a cause, instigation; from, out of, as an expression of.","example":"The invention was born of necessity.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|9","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(following an intransitive verb) Expressing origin. — Indicates the source or cause of the verb.","example":"It is said that she died of a broken heart.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|10","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","qual:following an intransitive verb","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(following an adjective) Expressing origin. — Indicates the subject or cause of the adjective.","example":"I am tired of all this nonsense.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|11","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","qual:following an adjective","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(following a passive verb) Expressing agency. — Indicates the agent (for most verbs, now usually expressed with by).","example":"I am not particularly enamoured of this idea.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|12","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","qual:following a passive verb","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing agency. — Used to introduce the \"subjective genitive\"; following a noun to form the head of a postmodifying noun phrase (see also 'Possession' senses below).","example":"The contract can be terminated at any time with the agreement of both parties.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|13","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(following an adjective) Expressing agency. — Used to indicate the agent of something described by the adjective.","example":"It was very brave of you to speak out like that.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|14","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","qual:following an adjective","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(making etc.) Expressing composition, substance. — Used to indicate the material or substance used.","example":"Many 'corks' are now actually made of plastic.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|15","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","rtag:after a verb expressing construction","qual:making etc.","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(directly following a noun) Expressing composition, substance. — Used to indicate the material of the just-mentioned object.","example":"She wore a dress of silk.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|16","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","qual:directly following a noun","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing composition, substance. — Indicating the composition of a given collective or quantitative noun.","example":"I'll have a dozen of those apples, please.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|17","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing composition, substance. — Used to link a given class of things with a specific example of that class.","example":"Welcome to the historic town of Harwich.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|18","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing composition, substance. — Links two nouns in near-apposition, with the first qualifying the second; \"which is also\".","example":"I'm not driving this wreck of a car.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|19","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Introducing subject matter. — Links an intransitive verb, or a transitive verb and its subject (especially verbs to do with thinking, feeling, expressing etc.), with its subject-matter; concerning, with regard to.","example":"I'm always thinking of you.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|20","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(following a noun (now chiefly nouns of knowledge, communication etc.)) Introducing subject matter. — Introduces its subject matter; about, concerning.","example":"He told us the story of his journey to India.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|21","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","qual:following a noun (now chiefly nouns of knowledge, communication etc.)","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(following an adjective) Introducing subject matter. — Introduces its subject matter.","example":"This behaviour is typical of teenagers.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|22","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","qual:following an adjective","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(following a number or other quantitive word) Having partitive effect. — Introduces the whole for which is indicated only the specified part or segment; \"from among\".","example":"Most of these apples are rotten.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|23","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","qual:following a number or other quantitive word","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(or as a predicate after to be, archaic, literary) Having partitive effect. — Some, an amount of, one of.","example":"On the whole, they seem to be of the decent sort.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|25","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","tag:archaic","tag:literary","rtag:with preceding partitive word assumed","qual:or as a predicate after to be","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Having partitive effect. — Links to a genitive noun or possessive pronoun, with partitive effect (though now often merged with possessive senses, below; see also double possessive).","example":"He is a friend of mine.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|26","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing possession. — Belonging to, existing in, or taking place in a given location, place or time. Compare \"origin\" senses, above.","example":"He was perhaps the most famous scientist of the twentieth century.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|27","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing possession. — Belonging to (a place) through having title, ownership or control over it.","example":"The owner of the nightclub was arrested.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|28","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing possession. — Belonging to (someone or something) as something they possess or have as a characteristic; the \"possessive genitive\". (With abstract nouns, this intersects with the subjective genitive, above under \"agency\" senses.)","example":"Keep the handle of the saucepan away from the flames.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"gram_function":[],"id":"of|preposition|29","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Forming the \"objective genitive\".","example":null,"frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,