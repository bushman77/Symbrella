of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(obsolete) Expressing separation. — Indicating removal, absence or separation, construed with an intransitive verb.","example":"He was kindly treated by the people at Saco, and recovered of his wounds.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792285133262,"gram_function":[],"id":"of|preposition|6","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","tag:obsolete","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing origin. — Indicating an ancestral source or origin of descent.","example":"The word is believed to be of Japanese origin.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792285133262,"gram_function":[],"id":"of|preposition|7","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing origin. — Introducing an epithet that indicates a birthplace, residence, dominion, or other place associated with the individual.","example":"Jesus of Nazareth (after hometown)","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792285133262,"gram_function":[],"id":"of|preposition|8","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing origin. — Indicating a (non-physical) source of action or emotion; introducing a cause, instigation; from, out of, as an expression of.","example":"The invention was born of necessity.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792285133262,"gram_function":[],"id":"of|preposition|9","lemma":"of","mw":false,"norm":"of","p