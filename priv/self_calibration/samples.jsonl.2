:4,"frame_ts_ms":1792284915043,"id":"bank|proper_noun|2","lemma":"bank","norm":"bank","pos":"proper_noun","score":0.5,"semantic_atoms":["ety:1","pos_raw:name"],"source":"ltm","synonyms":[],"token_index":4,"word":"bank"},{"antonyms":[],"definition":"A surname.","example":null,"frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"id":"bank|proper_noun|3","lemma":"bank","norm":"bank","pos":"proper_noun","score":0.5,"semantic_atoms":["ety:2","cat:en:english surnames","pos_raw:name"],"source":"ltm","synonyms":[],"token_index":4,"word":"bank"},{"antonyms":[],"definition":"(following a noun) Having partitive effect. — Indicates a given part.","example":"We want a larger slice of the cake.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"id":"of|preposition|24","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","qual:following a noun","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(except in phrases, dialectal, obsolete) Expressing distance or motion. — From (a place); off.","example":"Take the chicken out of the freezer.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"id":"of|preposition|1","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","tag:dialectal","tag:obsolete","qual:except in phrases","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(obsolete except in phrases) Expressing distance or motion. — Since, from (a given time, earlier state etc.).","example":"He hasn't been well of late.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284915043,"id":"of|preposition|2","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","qual:obsolete except in phrases","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"Expressing distance or motion. — From, away from (a position, number, distance etc.