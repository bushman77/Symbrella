","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Forming the \"objective genitive\".","example":null,"frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"gram_function":[],"id":"of|preposition|30","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Forming the \"objective genitive\". — Follows an agent noun, verbal noun or noun of action.","example":"She had a profound distrust of the police.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"gram_function":[],"id":"of|preposition|31","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(archaic, literary) Expressing qualities or characteristics. — Links an adjective with a noun or noun phrase to form a quasi-adverbial qualifier; in respect to, as regards.","example":"My companion seemed affable and easy of manner.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"gram_function":[],"id":"of|preposition|32","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","tag:archaic","tag:literary","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing qualities or characteristics. — Indicates a quality or characteristic; \"characterized by\".","example":"Pooh was said to be a bear of very little brain.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"gram_function":[],"id":"of|preposition|33","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},