ition","score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"Expressing separation. — Indicating removal, absence or separation, with the action indicated by a transitive verb and the quality or substance by a grammatical object.","example":"Finally she was relieved of the burden of caring for her sick husband.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"id":"of|preposition|4","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"Expressing separation. — Indicating removal, absence or separation, with resulting state indicated by an adjective.","example":"He seemed devoid of human feelings.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"id":"of|preposition|5","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(obsolete) Expressing separation. — Indicating removal, absence or separation, construed with an intransitive verb.","example":"He was kindly treated by the people at Saco, and recovered of his wounds.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"id":"of|preposition|6","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","tag:obsolete","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"Expressing origin. — Indicating an ancestral source or origin of descent.","example":"The word is believed to be of Japanese origin.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"id":"of|preposition|7","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"Expressing origin. — Introducing an epithet that indicates a birthplace, residence, dominion, or other place associated with the individual.","example":"Jesus of Nazareth (after hometown)","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"id":"of|preposition|8","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"Expressing origin. — Indicating a (non-physical) source of action or emotion; introducing a cause, instigation; from, out of, as an expression of.","example":"The invention was born of necessity.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"id":"of|preposition|9","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(following an intransitive verb) Expressing origin. — Indicates the source or cause of the verb.","example":"It is said that she died of a broken heart.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"id":"of|preposition|10","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","qual:following an intransitive verb","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(following an adjective) Expressing origin. — Indicates the subject or cause of the adjective.","example":"I am tired of all this nonsense.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"id":"of|preposition|11","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","qual:following an adjective","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(following a passive verb) Expressing agency. — Indicates the agent (for most verbs, now usually expressed with by).","example":"I am not particularly enamoured of this idea.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"id":"of|preposition|12","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","qual:following a passive verb","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"Expressing agency. — Used to introduce the \"subjective genitive\"; following a noun to form the head of a postmodifying noun phrase (see also 'Possession' senses below).","example":"The contract can be terminated at any time with the agreement of both parties.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"id":"of|preposition|13","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(following an adjective) Expressing agency. — Used to indicate the agent of something described by the adjective.","example":"It was very brave of you to speak out like that.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"id":"of|preposition|14","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","qual:following an adjective","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(making etc.) Expressing composition, substance. — Used to indicate the material or substance used.","example":"Many 'corks' are now actually made of plastic.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"id":"of|preposition|15","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","rtag:after a verb expressing construction","qual:making etc.","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(directly following a noun) Expressing composition, substance. — Used to indicate the material of the just-mentioned object.","example":"She wore a dress of silk.","frame_run_id":5,"frame_seq":4,"fra