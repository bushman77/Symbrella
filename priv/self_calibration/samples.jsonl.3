toms":["ety:1","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(following an intransitive verb) Expressing origin. — Indicates the source or cause of the verb.","example":"It is said that she died of a broken heart.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284480549,"id":"of|preposition|10","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","qual:following an intransitive verb","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(following an adjective) Expressing origin. — Indicates the subject or cause of the adjective.","example":"I am tired of all this nonsense.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284480549,"id":"of|preposition|11","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","qual:following an adjective","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(following a passive verb) Expressing agency. — Indicates the agent (for most verbs, now usually expressed with by).","example":"I am not particularly enamoured of this idea.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284480549,"id":"of|preposition|12","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","qual:following a passive verb","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"Expressing agency. — Used to introduce the \"subjective genitive\"; following a noun to form the head of a postmodifying noun phrase (see also 'Possession' senses below).","example":"The contract can be terminated at any time with the agreement of both parties.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284480549,"id":"of|preposition|13","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(following an adjective) Expressing agency. — Used to indicate the agent of something described by the adjective.","example":"It was very brave of you to speak out like that.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284480549,"id":"of|preposition|14","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","qual:following an adjective","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(making etc.) Expressing composition, substance. — Used to indicate the material or substance used.","example":"Many 'corks' are now actually made of plastic.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284480549,"id":"of|preposition|15","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","rtag:after a verb expressing construction","qual:making etc.","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"(directly following a noun) Expressing composition, substance. — Used to indicate the material of the just-mentioned object.","example":"She wore a dress of silk.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284480549,"id":"of|preposition|16","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","qual:directly following a noun","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"Expressing composition, substance. — Indicating the composition of a given collective or quantitative noun.","example":"I'll have a dozen of those apples, please.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284480549,"id":"of|preposition|17","lemma":"of","norm":"of","pos":"preposition","score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"ltm","synonyms":[],"token_index":5,"word":"of"},{"antonyms":[],"definition":"Expressing composition, substance. — Used to link a given class of things with a specific example 