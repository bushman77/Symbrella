e":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(following an adjective) Expressing agency. — Used to indicate the agent of something described by the adjective.","example":"It was very brave of you to speak out like that.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"gram_function":[],"id":"of|preposition|14","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","qual:following an adjective","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(making etc.) Expressing composition, substance. — Used to indicate the material or substance used.","example":"Many 'corks' are now actually made of plastic.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"gram_function":[],"id":"of|preposition|15","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","rtag:after a verb expressing construction","qual:making etc.","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(directly following a noun) Expressing composition, substance. — Used to indicate the material of the just-mentioned object.","example":"She wore a dress of silk.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"gram_function":[],"id":"of|preposition|16","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","qual:directly following a noun","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing composition, substance. — Indicating the composition of a given collective or quantitative noun.","example":"I'll have a dozen of those apples, please.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"gram_function":[],"id":"of|preposition|17","lemma":"of","mw":false,"no