antic_atoms":["ety:1","qual:following a noun","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(except in phrases, dialectal, obsolete) Expressing distance or motion. — From (a place); off.","example":"Take the chicken out of the freezer.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"gram_function":[],"id":"of|preposition|1","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","tag:dialectal","tag:obsolete","qual:except in phrases","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"(obsolete except in phrases) Expressing distance or motion. — Since, from (a given time, earlier state etc.).","example":"He hasn't been well of late.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"gram_function":[],"id":"of|preposition|2","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","qual:obsolete except in phrases","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing distance or motion. — From, away from (a position, number, distance etc.).","example":"There are no shops within twenty miles of the cottage.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"gram_function":[],"id":"of|preposition|3","lemma":"of","mw":false,"norm":"of","pos":"preposition","rel_prior":0.2,"score":0.5,"semantic_atoms":["ety:1","pos_raw:prep"],"source":"active_cells","synonyms":[]},{"activation":0.25,"antonyms":[],"definition":"Expressing separation. — Indicating removal, absence or separation, with the action indicated by a transitive verb and the quality or substance by a grammatical object.","example":"Finally she was relieved of the burden of caring for her sick husband.","frame_run_id":5,"frame_seq":4,"frame_ts_ms":1792284487790,"gram_function":[],"id":"of|preposition|4","lemma":"of","