# ───────── Elixir / Mix / Erlang ─────────
/_build/
/deps/
*.beam
*.ez
erl_crash.dump
.erlang.cookie

# Dialyzer PLTs (large, machine-local)
/priv/plts/
/apps/*/priv/plts/
*.plt
*.plt.hash

# ───────── Logs, coverage, and temporary files ─────────
/log/
tmp/
cover/
*.coverdata

# Runtime cache (not source)
/apps/core/priv/negcache/
*.dets

# ───────── Editors and local tooling ─────────
.elixir_ls/
apps/*/.elixir_ls/
.elixir-tools/
.elixir-tools.json
/.idea/
/.vscode/
*.swp
*~
.DS_Store
Thumbs.db
.aider*

# ───────── Phoenix / frontend build artifacts ─────────
/apps/*/priv/static/assets/
/apps/*/priv/static/cache_manifest.json
/assets/node_modules/
/apps/*/assets/node_modules/
/apps/*/node_modules/
/apps/*/assets/.vite/
/apps/*/assets/.cache/
/apps/*/assets/dist/

# ───────── Local configuration and secrets ─────────
.env
.env.*
config/*.secret.exs
config/*_secret.exs
config/prod.secret.exs

# ───────── Dictionary corpora (downloaded/generated) ─────────
# Raw Kaikki/Wiktextract dump and partial download.
/apps/db/priv/raw-wiktextract-data.jsonl.gz
/apps/db/priv/raw-wiktextract-data.jsonl.gz.part

# Extracted English corpus and incomplete output.
/apps/db/priv/english.jsonl
/apps/db/priv/english.jsonl.tmp

# Legacy corpus name.
/apps/db/priv/kaikki.org-dictionary-English.jsonl

# ───────── Training data and model artifacts ─────────
# Runtime self-calibration samples, including numbered rotations/backups.
# Keep deliberately checked-in synthetic fixtures separate.
/priv/self_calibration/samples.jsonl*
/apps/*/priv/self_calibration/samples.jsonl*

# Optional external-data directories if created inside this working tree.
/symbrella-data/
/training-data/

# Downloaded or generated model weights/checkpoints.
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx

# ───────── Database exports and local dependencies ─────────
/apps/db/priv/db/*.sql.gz
/pgvector/

# ───────── Miscellaneous generated output ─────────
output.txt
